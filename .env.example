# openai | anthropic | litellm | local   (local = Ollama / LM Studio / vLLM / any OpenAI-compatible server)
PROVIDER=openai
MODEL=gpt-4o-mini
# Key for the chosen provider. OPENAI_API_KEY / ANTHROPIC_API_KEY / LITELLM_API_KEY are also accepted.
API_KEY=
# Optional endpoint override. Defaults: openai https://api.openai.com/v1 · anthropic https://api.anthropic.com
#   litellm http://localhost:4000 · local http://localhost:11434/v1 (Ollama; LM Studio is http://localhost:1234/v1)
BASE_URL=
# Set to "none" for reasoning models that reject a temperature parameter.
TEMPERATURE=0.7
MAX_TOKENS=2000
LLM_TIMEOUT=180

# --- examples ---
# PROVIDER=anthropic   MODEL=claude-sonnet-4-5          API_KEY=sk-ant-...
# PROVIDER=litellm     MODEL=<proxy model alias>        API_KEY=sk-<litellm key>   BASE_URL=http://localhost:4000
# PROVIDER=local       MODEL=qwen2.5:3b                 (run: ollama pull qwen2.5:3b)
